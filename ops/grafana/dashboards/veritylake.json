{
  "title": "VerityLake | Trust and Reliability",
  "uid": "veritylake",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Active chunks",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "veritylake-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "veritylake_active_chunks",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Dataset age (hours)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "veritylake-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "(time() - veritylake_dataset_created_timestamp_seconds) / 3600",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Answer requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "veritylake-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(veritylake_http_requests_total{route=\"/ask\"}[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Answer latency p95",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "veritylake-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(veritylake_http_duration_seconds_bucket{route=\"/ask\"}[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "Abstention rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "veritylake-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(veritylake_answers_total{status=\"abstained\"}[5m])) / clamp_min(sum(rate(veritylake_answers_total[5m])), 0.001)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "5xx requests / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "veritylake-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(rate(veritylake_http_requests_total{status=~\"5..\"}[5m]))",
          "refId": "A"
        }
      ]
    }
  ]
}