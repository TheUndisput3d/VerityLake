# Generate real local secrets with: python3 scripts/bootstrap.py
# This example is safe to commit. Never commit .env, model weights, or source data.
COMPOSE_PROJECT_NAME=veritylake
ENVIRONMENT=local
API_KEY=CHANGE_ME_GENERATE_WITH_BOOTSTRAP
MINIO_ROOT_USER=vl-root
MINIO_ROOT_PASSWORD=CHANGE_ME_GENERATE_WITH_BOOTSTRAP
LAKE_WRITER_USER=vl-writer
LAKE_WRITER_PASSWORD=CHANGE_ME_GENERATE_WITH_BOOTSTRAP
LAKE_READER_USER=vl-reader
LAKE_READER_PASSWORD=CHANGE_ME_GENERATE_WITH_BOOTSTRAP
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_WITH_BOOTSTRAP
AIRFLOW_ADMIN_PASSWORD=CHANGE_ME_GENERATE_WITH_BOOTSTRAP
AIRFLOW_JWT_SECRET=CHANGE_ME_GENERATE_WITH_BOOTSTRAP
AIRFLOW_FERNET_KEY=CHANGE_ME_GENERATE_WITH_BOOTSTRAP
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GENERATE_WITH_BOOTSTRAP
LOCAL_UID=1000
LOCAL_GID=1000
S3_BUCKET=veritylake
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://minio:9000
SOURCE_URL=https://books.toscrape.com/
SOURCE_ADAPTER=books
SOURCE_PATH_PREFIX=/
SOURCE_RECORD_PATTERN='/catalogue/(?!category/|page-)[^/]+/index\.html$'
SOURCE_SELECTOR=main
MAX_PAGES=60
MIN_DOCUMENTS=50
MAX_FETCHES=180
REQUEST_INTERVAL_SECONDS=0.5
MIN_TEXT_CHARS=100
MAX_REJECT_FRACTION=0.2
MAX_SOURCE_AGE_HOURS=72
CHUNK_WORDS=220
CHUNK_OVERLAP_WORDS=35
MAX_CHUNKS=1500
EMBEDDING_MODEL=nomic-embed-text:v1.5
LLM_MODEL=qwen3:4b
EMBEDDING_BATCH_SIZE=16
MODEL_TIMEOUT_SECONDS=180
RETRIEVAL_MAX_DISTANCE=0.65
REQUESTS_PER_MINUTE=30
MAX_CONCURRENT_REQUESTS=2
GIT_SHA=development
LOG_FORMAT=json
# Optional receiver BASE URL (the client appends /api/v1/lineage); events are also stored in the lake.
OPENLINEAGE_URL=
# Versions are deliberate baselines, not a claim of security certification.
APP_IMAGE=veritylake/app:local
AIRFLOW_IMAGE=veritylake/airflow:local
STORAGE_IMAGE=veritylake/minio:security-source
STORAGE_TOOLS_IMAGE=veritylake/storage-tools:local
OLLAMA_IMAGE=ollama/ollama:0.34.2
CHROMA_IMAGE=chromadb/chroma:1.5.9
